# Environment Variables
NODE_ENV=development
REPL_ID=your_repl_id_here
PORT=5000
XAI_API_KEY=demo-key
DATABASE_URL=./database.sqlite
SESSION_SECRET=zeolfdocs_secure_session_secret_123

# --- Rescue login -----------------------------------------------------------
# Emergency super-admin code for when the database has no usable users table.
# NOTE: this file is NOT auto-loaded by `npm run dev` (tsx does not read .env),
# so pass these on the command line or export them in the shell:
#   BOOTSTRAP_LOGIN_CODE=my-private-code npm run dev
# Defaults to "RESCUE-2025" in development. In production it is disabled unless
# BOTH BOOTSTRAP_LOGIN_CODE and ENABLE_BOOTSTRAP_LOGIN=true are set. Set
# BOOTSTRAP_LOGIN_CODE="" to turn it off.
# BOOTSTRAP_LOGIN_CODE=RESCUE-2025
# ENABLE_BOOTSTRAP_LOGIN=true
